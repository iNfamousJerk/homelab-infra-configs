# ──────────────────────────────────────────────────────────────
# Environment template — copy to .env and fill in real values.
#   cp .env.example .env && $EDITOR .env
#
# .env is gitignored; this file is not. Never put real secrets here.
#
# Vars written as ${VAR:?...} in the compose files are REQUIRED: compose
# aborts with that message if they are unset, rather than silently starting
# a service with an empty password.
# ──────────────────────────────────────────────────────────────

# ─── docker-compose.yml (monitoring stack) ───────────────────
# Grafana initial admin password. Required.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Pi-hole web password, for the metrics exporter. Required.
PIHOLE_PASSWORD=CHANGE_ME
# Pi-hole address (optional, default 10.0.0.2)
#PIHOLE_HOSTNAME=
# NUT (UPS) monitor-user password. Required.
NUT_PASSWORD=CHANGE_ME
# NUT server address (optional, default monitoring.internal.lan)
#NUT_HOST=

# ─── media-stack.yml ─────────────────────────────────────────
# ProtonVPN credentials for the Gluetun gateway. Required.
VPN_USER=CHANGE_ME
VPN_PASSWORD=CHANGE_ME
# qBittorrent WebUI password. Required — the UI is published on :8080.
QBITTORRENT_WEBUI_PASSWORD=CHANGE_ME
# WireGuard alternative to OpenVPN — only needed if VPN_TYPE=wireguard
#WG_PRIVATE_KEY=
#WG_ADDRESSES=

# ─── media-stack.yml / media-stack-testing.yml / nextcloud-office-stack.yml ───
# Vaultwarden admin panel token. Required.
# Generate with: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME

# ─── nextcloud-office-stack.yml ──────────────────────────────
# Shared secret between Nextcloud and OnlyOffice. Required.
# Generate with: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=CHANGE_ME

# ─── scripts/media-dash.py ───────────────────────────────────
# Host running the *arr services (IP or hostname, no scheme).
MEDIA_HOST=CHANGE_ME
# *arr API keys — Settings > General > API Key in each app.
RADARR_KEY=CHANGE_ME
SONARR_KEY=CHANGE_ME
LIDARR_KEY=CHANGE_ME
READARR_KEY=CHANGE_ME
